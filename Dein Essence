<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>DEIN ESSENCE | Luxury Perfumes</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

    <style>

        /* =========================================================
           DEIN ESSENCE
           LUXURY PERFUME E-COMMERCE
           ========================================================= */

        :root {
            --black: #050505;
            --black-soft: #0b0b0b;
            --black-card: #101010;

            --gold: #d4af37;
            --gold-light: #f2d675;
            --gold-dark: #9d7b19;

            --white: #ffffff;
            --text: #eeeeee;
            --muted: #969696;

            --border: rgba(212, 175, 55, 0.25);

            --glass: rgba(255, 255, 255, 0.045);
            --glass-strong: rgba(255, 255, 255, 0.07);

            --serif: "Cormorant Garamond", serif;
            --sans: "Montserrat", sans-serif;

            --transition: 0.3s ease;
        }

        /* =========================================================
           RESET
           ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background:
                radial-gradient(
                    circle at 85% 10%,
                    rgba(212, 175, 55, 0.08),
                    transparent 28%
                ),
                radial-gradient(
                    circle at 5% 50%,
                    rgba(212, 175, 55, 0.04),
                    transparent 25%
                ),
                var(--black);

            color: var(--white);
            font-family: var(--sans);

            overflow-x: hidden;
        }

        body.no-scroll {
            overflow: hidden;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button,
        input {
            font-family: inherit;
        }

        button {
            border: none;
        }

        /* =========================================================
           GLOBAL
           ========================================================= */

        .container {
            width: min(1200px, 90%);
            margin: auto;
        }

        .gold {
            color: var(--gold);
        }

        .section {
            padding: 110px 0;
        }

        .section-heading {
            text-align: center;
            margin-bottom: 50px;
        }

        .eyebrow {
            color: var(--gold);
            font-size: 10px;
            letter-spacing: 5px;
            text-transform: uppercase;
        }

        .section-heading h2 {
            margin-top: 15px;

            font-family: var(--serif);
            font-size: clamp(45px, 6vw, 70px);
            font-weight: 500;
            line-height: 1;
        }

        .section-heading p {
            max-width: 600px;
            margin: 20px auto 0;

            color: var(--muted);

            font-size: 13px;
            line-height: 1.9;
        }

        /* =========================================================
           GLASS
           ========================================================= */

        .glass {
            background: var(--glass);

            border: 1px solid rgba(255,255,255,0.09);

            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        /* =========================================================
           NAVIGATION
           ========================================================= */

        .navbar {
            position: fixed;

            top: 0;
            left: 0;

            width: 100%;
            height: 78px;

            z-index: 1000;

            background: rgba(5,5,5,0.78);

            border-bottom: 1px solid rgba(255,255,255,0.07);

            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .nav-inner {
            width: min(1400px, 92%);
            height: 100%;

            margin: auto;

            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-family: var(--serif);
            font-size: 29px;
            font-weight: 600;
            letter-spacing: 4px;
        }

        .logo span {
            color: var(--gold);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 34px;
        }

        .nav-links a {
            position: relative;

            color: #cfcfcf;

            font-size: 10px;
            letter-spacing: 2px;
            text-transform: uppercase;

            transition: var(--transition);
        }

        .nav-links a::after {
            content: "";

            position: absolute;

            left: 0;
            bottom: -8px;

            width: 0;
            height: 1px;

            background: var(--gold);

            transition: var(--transition);
        }

        .nav-links a:hover {
            color: var(--gold);
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .nav-icon {
            width: 40px;
            height: 40px;

            display: flex;
            align-items: center;
            justify-content: center;

            color: var(--gold);

            border: 1px solid rgba(212,175,55,0.25);

            border-radius: 50%;

            cursor: pointer;

            transition: var(--transition);
        }

        .nav-icon:hover {
            color: #000;
            background: var(--gold);

            box-shadow:
                0 0 25px rgba(212,175,55,0.25);
        }

        .cart-icon {
            position: relative;
        }

        .cart-count {
            position: absolute;

            top: -5px;
            right: -5px;

            min-width: 17px;
            height: 17px;

            padding: 0 4px;

            display: flex;
            align-items: center;
            justify-content: center;

            background: var(--gold);
            color: #000;

            border-radius: 50%;

            font-size: 8px;
            font-weight: 700;
        }

        .menu-btn {
            display: none;

            color: var(--gold);

            font-size: 20px;

            cursor: pointer;
        }

        /* =========================================================
           HERO
           ========================================================= */

        .hero {
            min-height: 100vh;

            padding-top: 78px;

            display: flex;
            align-items: center;

            position: relative;

            overflow: hidden;
        }

        .hero::before {
            content: "";

            position: absolute;

            width: 600px;
            height: 600px;

            right: -200px;
            top: 50px;

            border-radius: 50%;

            background: rgba(212,175,55,0.08);

            filter: blur(100px);
        }

        .hero-grid {
            width: min(1200px, 90%);

            margin: auto;

            display: grid;
            grid-template-columns: 1.1fr 0.9fr;

            gap: 80px;

            align-items: center;

            position: relative;
            z-index: 2;
        }

        .hero-content .eyebrow {
            margin-bottom: 25px;
        }

        .hero-content h1 {
            font-family: var(--serif);

            font-size: clamp(65px, 8vw, 115px);

            font-weight: 500;

            line-height: 0.82;

            margin-bottom: 35px;
        }

        .hero-content h1 span {
            display: block;

            color: var(--gold);

            font-style: italic;
        }

        .hero-content p {
            max-width: 520px;

            margin-bottom: 38px;

            color: var(--muted);

            font-size: 13px;

            line-height: 2;
        }

        .hero-buttons {
            display: flex;
            gap: 12px;
        }

        .btn {
            min-height: 48px;

            padding: 0 27px;

            display: inline-flex;
            align-items: center;
            justify-content: center;

            border: 1px solid var(--gold);

            font-size: 9px;
            letter-spacing: 2px;
            text-transform: uppercase;

            cursor: pointer;

            transition: var(--transition);
        }

        .btn-gold {
            background: var(--gold);
            color: #000;
        }

        .btn-gold:hover {
            background: var(--gold-light);

            transform: translateY(-2px);

            box-shadow:
                0 10px 35px rgba(212,175,55,0.2);
        }

        .btn-outline {
            color: var(--gold);
            background: transparent;
        }

        .btn-outline:hover {
            color: #000;
            background: var(--gold);
        }

        /* =========================================================
           HERO PERFUME
           ========================================================= */

        .hero-product {
            min-height: 560px;

            display: flex;
            align-items: center;
            justify-content: center;

            position: relative;
        }

        .hero-product::before {
            content: "";

            position: absolute;

            width: 390px;
            height: 390px;

            border-radius: 50%;

            border: 1px solid rgba(212,175,55,0.13);

            box-shadow:
                0 0 90px rgba(212,175,55,0.08),
                inset 0 0 70px rgba(212,175,55,0.04);
        }

        .perfume-bottle {
            width: 230px;
            height: 330px;

            position: relative;

            z-index: 2;
        }

        .bottle-cap {
            position: absolute;

            top: 0;
            left: 50%;

            transform: translateX(-50%);

            width: 95px;
            height: 65px;

            border-radius: 7px 7px 4px 4px;

            background:
                linear-gradient(
                    90deg,
                    #715614,
                    #f3d36a,
                    #967419
                );

            box-shadow:
                0 15px 30px rgba(0,0,0,0.6);
        }

        .bottle-neck {
            position: absolute;

            top: 58px;
            left: 50%;

            transform: translateX(-50%);

            width: 65px;
            height: 48px;

            background: rgba(220,180,60,0.3);

            border: 1px solid rgba(212,175,55,0.5);
        }

        .bottle-body {
            position: absolute;

            bottom: 0;

            left: 50%;

            transform: translateX(-50%);

            width: 190px;
            height: 250px;

            border-radius: 22px 22px 35px 35px;

            background:
                linear-gradient(
                    135deg,
                    rgba(255,255,255,0.16),
                    rgba(212,175,55,0.12),
                    rgba(255,255,255,0.03)
                );

            border: 1px solid rgba(255,255,255,0.2);

            backdrop-filter: blur(12px);

            box-shadow:
                inset 0 0 40px rgba(255,255,255,0.04),
                0 30px 70px rgba(0,0,0,0.7),
                0 0 60px rgba(212,175,55,0.10);

            display: flex;
            align-items: center;
            justify-content: center;
        }

        .bottle-label {
            width: 140px;

            padding: 24px 10px;

            text-align: center;

            border: 1px solid rgba(212,175,55,0.5);

            background: rgba(0,0,0,0.4);
        }

        .bottle-label small {
            display: block;

            color: var(--gold);

            font-size: 8px;
            letter-spacing: 3px;
        }

        .bottle-label strong {
            display: block;

            margin: 7px 0;

            font-family: var(--serif);

            font-size: 22px;
            font-weight: 500;
        }

        .bottle-label span {
            color: var(--muted);

            font-size: 7px;
            letter-spacing: 2px;
        }

        /* =========================================================
           TRUST BAR
           ========================================================= */

        .trust-bar {
            width: min(1100px, 90%);

            margin: -35px auto 0;

            position: relative;
            z-index: 5;

            display: grid;
            grid-template-columns: repeat(4, 1fr);

            background: rgba(255,255,255,0.035);

            border: 1px solid rgba(255,255,255,0.09);

            backdrop-filter: blur(20px);
        }

        .trust-item {
            padding: 24px;

            display: flex;
            align-items: center;

            gap: 14px;

            border-right: 1px solid rgba(255,255,255,0.08);
        }

        .trust-item:last-child {
            border-right: none;
        }

        .trust-item i {
            color: var(--gold);
            font-size: 17px;
        }

        .trust-item strong {
            display: block;

            margin-bottom: 5px;

            font-size: 9px;
            letter-spacing: 1px;
        }

        .trust-item span {
            color: var(--muted);

            font-size: 8px;
        }

        /* =========================================================
           SEARCH BAR
           ========================================================= */

        .search-wrapper {
            max-width: 700px;

            margin: 0 auto 30px;

            position: relative;
        }

        .search-wrapper i {
            position: absolute;

            left: 18px;
            top: 50%;

            transform: translateY(-50%);

            color: var(--gold);

            font-size: 13px;
        }

        #productSearch {
            width: 100%;

            height: 50px;

            padding: 0 20px 0 48px;

            outline: none;

            color: white;

            background: rgba(255,255,255,0.04);

            border: 1px solid rgba(255,255,255,0.1);

            font-size: 11px;

            transition: var(--transition);
        }

        #productSearch:focus {
            border-color: rgba(212,175,55,0.5);

            box-shadow:
                0 0 25px rgba(212,175,55,0.06);
        }

        #productSearch::placeholder {
            color: #666;
        }

        /* =========================================================
           FILTERS
           ========================================================= */

        .filters {
            display: flex;

            justify-content: center;

            flex-wrap: wrap;

            gap: 9px;

            margin-bottom: 45px;
        }

        .filter-btn {
            padding: 11px 20px;

            color: var(--muted);

            background: rgba(255,255,255,0.03);

            border: 1px solid rgba(255,255,255,0.1);

            font-size: 8px;
            letter-spacing: 2px;

            text-transform: uppercase;

            cursor: pointer;

            transition: var(--transition);
        }

        .filter-btn:hover,
        .filter-btn.active {
            color: #000;

            background: var(--gold);

            border-color: var(--gold);
        }

        /* =========================================================
           PRODUCTS
           ========================================================= */

        .products {
            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 24px;
        }

        .product-card {
            overflow: hidden;

            background: rgba(255,255,255,0.035);

            border: 1px solid rgba(255,255,255,0.08);

            transition: var(--transition);
        }

        .product-card:hover {
            transform: translateY(-7px);

            border-color: rgba(212,175,55,0.4);

            box-shadow:
                0 25px 70px rgba(0,0,0,0.4);
        }

        .product-card.hidden {
            display: none;
        }

        .product-image {
            height: 350px;

            display: flex;
            align-items: center;
            justify-content: center;

            position: relative;

            background:
                radial-gradient(
                    circle,
                    rgba(212,175,55,0.10),
                    transparent 65%
                );
        }

        .product-image::after {
            content: "";

            position: absolute;

            bottom: 32px;

            width: 140px;
            height: 13px;

            border-radius: 50%;

            background: rgba(0,0,0,0.5);

            filter: blur(10px);
        }

        .mini-bottle {
            width: 100px;
            height: 190px;

            position: relative;

            z-index: 2;

            border-radius: 13px 13px 20px 20px;

            border: 1px solid rgba(255,255,255,0.25);

            background:
                linear-gradient(
                    135deg,
                    rgba(255,255,255,0.18),
                    rgba(212,175,55,0.12)
                );

            box-shadow:
                0 25px 45px rgba(0,0,0,0.6);
        }

        .mini-bottle::before {
            content: "";

            position: absolute;

            top: -38px;
            left: 25px;

            width: 48px;
            height: 40px;

            border-radius: 5px 5px 2px 2px;

            background:
                linear-gradient(
                    90deg,
                    #775d19,
                    #e4c65d,
                    #8e701c
                );
        }

        .mini-label {
            position: absolute;

            top: 65px;
            left: 10px;

            width: 80px;

            padding: 10px 3px;

            text-align: center;

            border: 1px solid rgba(212,175,55,0.5);

            background: rgba(0,0,0,0.45);
        }

        .mini-label span {
            font-family: var(--serif);
            font-size: 12px;
        }

        .product-info {
            padding: 24px;
        }

        .product-category {
            color: var(--gold);

            font-size: 8px;
            letter-spacing: 3px;

            text-transform: uppercase;

            margin-bottom: 8px;
        }

        .product-info h3 {
            font-family: var(--serif);

            font-size: 29px;
            font-weight: 500;

            margin-bottom: 8px;
        }

        .product-info p {
            min-height: 40px;

            color: var(--muted);

            font-size: 10px;
            line-height: 1.8;

            margin-bottom: 18px;
        }

        .product-bottom {
            display: flex;

            align-items: center;
            justify-content: space-between;
        }

        .price {
            color: var(--gold);

            font-family: var(--serif);

            font-size: 25px;
        }

        .add-cart {
            width: 42px;
            height: 42px;

            display: flex;
            align-items: center;
            justify-content: center;

            color: var(--gold);

            background: transparent;

            border: 1px solid rgba(212,175,55,0.4);

            cursor: pointer;

            transition: var(--transition);
        }

        .add-cart:hover {
            color: #000;
            background: var(--gold);
        }

        .no-results {
            display: none;

            grid-column: 1 / -1;

            padding: 70px 20px;

            text-align: center;

            color: var(--muted);
        }

        .no-results i {
            display: block;

            margin-bottom: 15px;

            color: var(--gold);

            font-size: 30px;
        }

        /* =========================================================
           ABOUT
           ========================================================= */

        .about {
            display: grid;

            grid-template-columns: 1fr 1fr;

            gap: 80px;

            align-items: center;
        }

        .about-visual {
            min-height: 500px;

            display: flex;
            align-items: center;
            justify-content: center;

            position: relative;

            border: 1px solid rgba(255,255,255,0.08);

            background:
                linear-gradient(
                    145deg,
                    rgba(212,175,55,0.08),
                    rgba(255,255,255,0.025)
                );
        }

        .about-frame {
            width: 75%;
            height: 75%;

            display: flex;
            align-items: center;
            justify-content: center;

            position: relative;

            border: 1px solid rgba(212,175,55,0.4);
        }

        .about-logo {
            text-align: center;
        }

        .about-logo span {
            display: block;

            color: var(--gold);

            font-size: 8px;
            letter-spacing: 5px;
        }

        .about-logo strong {
            display: block;

            font-family: var(--serif);

            font-size: 55px;

            font-weight: 500;
        }

        .about-content h2 {
            margin: 18px 0 25px;

            font-family: var(--serif);

            font-size: clamp(45px, 5vw, 70px);

            font-weight: 500;

            line-height: 0.95;
        }

        .about-content p {
            color: var(--muted);

            font-size: 12px;

            line-height: 2;

            margin-bottom: 18px;
        }

        /* =========================================================
           CTA
           ========================================================= */

        .cta {
            padding: 100px 20px;

            text-align: center;

            border-top: 1px solid rgba(212,175,55,0.2);
            border-bottom: 1px solid rgba(212,175,55,0.2);

            background:
                radial-gradient(
                    circle at center,
                    rgba(212,175,55,0.12),
                    transparent 60%
                );
        }

        .cta h2 {
            margin: 20px 0 30px;

            font-family: var(--serif);

            font-size: clamp(50px, 7vw, 90px);

            font-weight: 500;
        }

        /* =========================================================
           FOOTER
           ========================================================= */

        footer {
            padding: 70px 0 30px;

            background: #030303;
        }

        .footer-grid {
            display: grid;

            grid-template-columns: 2fr 1fr 1fr 1fr;

            gap: 50px;

            padding-bottom: 45px;

            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .footer-brand p {
            max-width: 350px;

            margin-top: 20px;

            color: var(--muted);

            font-size: 10px;

            line-height: 2;
        }

        .footer-column h4 {
            margin-bottom: 20px;

            color: var(--gold);

            font-size: 8px;
            letter-spacing: 3px;

            text-transform: uppercase;
        }

        .footer-column a {
            display: block;

            margin-bottom: 12px;

            color: var(--muted);

            font-size: 10px;

            transition: var(--transition);
        }

        .footer-column a:hover {
            color: var(--gold);
        }

        .socials {
            display: flex;
            gap: 8px;
        }

        .socials a {
            width: 34px;
            height: 34px;

            display: flex;
            align-items: center;
            justify-content: center;

            border: 1px solid rgba(255,255,255,0.1);

            transition: var(--transition);
        }

        .socials a:hover {
            color: #000;
            background: var(--gold);
            border-color: var(--gold);
        }

        .footer-bottom {
            padding-top: 25px;

            display: flex;
            justify-content: space-between;

            color: #555;

            font-size: 8px;
            letter-spacing: 1px;
        }

        /* =========================================================
           CART OVERLAY
           ========================================================= */

        .cart-overlay {
            position: fixed;

            inset: 0;

            z-index: 1998;

            background: rgba(0,0,0,0.65);

            opacity: 0;
            visibility: hidden;

            transition: var(--transition);
        }

        .cart-overlay.active {
            opacity: 1;
            visibility: visible;
        }

        /* =========================================================
           CART DRAWER
           ========================================================= */

        .cart-drawer {
            position: fixed;

            top: 0;
            right: -450px;

            width: min(430px, 92vw);
            height: 100vh;

            z-index: 2000;

            display: flex;
            flex-direction: column;

            background:
                linear-gradient(
                    145deg,
                    rgba(18,18,18,0.98),
                    rgba(5,5,5,0.98)
                );

            border-left: 1px solid rgba(212,175,55,0.25);

            transition: 0.4s ease;

            box-shadow:
                -20px 0 80px rgba(0,0,0,0.5);
        }

        .cart-drawer.active {
            right: 0;
        }

        .cart-header {
            height: 80px;

            padding: 0 25px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

        .cart-header h3 {
            font-family: var(--serif);

            font-size: 30px;

            font-weight: 500;
        }

        .close-cart {
            width: 38px;
            height: 38px;

            display: flex;
            align-items: center;
            justify-content: center;

            color: var(--gold);

            background: transparent;

            border: 1px solid rgba(212,175,55,0.25);

            cursor: pointer;

            transition: var(--transition);
        }

        .close-cart:hover {
            color: #000;
            background: var(--gold);
        }

        .cart-items {
            flex: 1;

            overflow-y: auto;

            padding: 20px;
        }

        .cart-item {
            display: grid;

            grid-template-columns: 65px 1fr auto;

            gap: 14px;

            padding: 16px 0;

            border-bottom: 1px solid rgba(255,255,255,0.08);
        }

